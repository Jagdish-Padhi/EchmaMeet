# ============================================================================
# EchmaMeet Environment Configuration Template
# ============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# NOTE: .env is ignored by git and must never be committed.
# All fields below are pre-configured with resilient defaults.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Server Core Configuration
# ----------------------------------------------------------------------------
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
DATA_DIR=./data
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# 2. Database: PostgreSQL (Neon Serverless / Supabase / Local PostgreSQL)
# ----------------------------------------------------------------------------
# Where to get: Free tier at https://neon.tech
# Example: postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# What it stores: the voice ledger (every spoken command, language, status, STT/TTS latency)
# behind GET /api/voice/history and /api/voice/analytics. Migrations run automatically on boot.
# If empty, or if the connection fails, a bounded in-memory ledger is used and the log says so.
# Experiment/run state stays in embedded SQLite (./data/chaosboard.sqlite) by design.
DATABASE_URL=

# ----------------------------------------------------------------------------
# 3. Distributed Job Queue: Redis & BullMQ (Upstash / Local Redis)
# ----------------------------------------------------------------------------
# Where to get: Free serverless Redis at https://upstash.com
# Example: rediss://default:token@xyz.upstash.io:6379
# NOTE: If left empty, EchmaMeet executes all background failure runs and chaos trials in-process.
REDIS_URL=

# ----------------------------------------------------------------------------
# 4. Gnani AI: speech (Prisma STT + Timbre TTS)
# ----------------------------------------------------------------------------
# Get a key at https://app.gnani.ai/voice (sent as the X-API-Key-ID header).
# Without it the app still runs: typed commands work, voice features report "not configured".
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
# prisma-v3.0 (10 Indian languages, code-mixed, indic-auto) or prisma-v2.5.
# If your account is not enabled for v3.0 the server retries once on v2.5.
GNANI_STT_MODEL=prisma-v3.0
# timbre-v2.5 (one preferred voice per language) or timbre-v3.0 (all voices, all languages).
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_SAMPLE_RATE=48000

# ----------------------------------------------------------------------------
# 5. Groq Cloud AI / Gnani Evon: High-Speed LLM Inference & Architecture Reasoning
# ----------------------------------------------------------------------------
# Powers Echma's real-time SRE reasoning, dynamic opinion generation with Gnani
# audio expression tags (<Excited>, <Pauses>, <Slow>), and autonomous repairs.
# Supports Groq Cloud (ultra-fast inference, free key at https://console.groq.com)
# or any OpenAI-compatible endpoint (vLLM / open-weight Gnani Evon).
# If omitted, Echma defaults to the deterministic topology hazard rule engine and trained ML diagnosis.
EVON_BASE_URL=https://api.groq.com/openai/v1
EVON_API_KEY=
EVON_MODEL_ID=llama-3.3-70b-versatile

# ----------------------------------------------------------------------------
# 5. Chaos Injection Engine: Toxiproxy HTTP API
# ----------------------------------------------------------------------------
# Where to get: https://github.com/Shopify/toxiproxy (releases or docker run -p 8474:8474 ghcr.io/shopify/toxiproxy)
# - Host native: http://127.0.0.1:8474
# - Docker network: http://toxiproxy:8474
TOXIPROXY_URL=http://127.0.0.1:8474

# ----------------------------------------------------------------------------
# 6. Authentication & Security (JWT Session Signing)
# ----------------------------------------------------------------------------
# Secret key for HMAC-SHA256 session token generation. Change to any random string in production.
JWT_SECRET=echmameet-enterprise-jwt-secret-replace-with-your-key-2026
JWT_EXPIRES_IN=1209600

# ----------------------------------------------------------------------------
# 7. Firebase Google Authentication (Quick, Free & Stable Popup Login)
# ----------------------------------------------------------------------------
# Where to get (Free in 2 mins at https://console.firebase.google.com):
# 1. Click "Add project" (or select an existing one).
# 2. Go to "Build" > "Authentication" > "Get Started" > enable "Google".
# 3. Go to Project Settings (gear icon) > "General" > scroll down to "Your apps" > click "</>" (Web).
# 4. Copy the keys from the firebaseConfig snippet below:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server Firebase project validation:
FIREBASE_PROJECT_ID=
GOOGLE_CLIENT_ID=

# ----------------------------------------------------------------------------
# 8. Single Sign-On (SSO): GitHub OAuth App
# ----------------------------------------------------------------------------
# Where to get: https://github.com/settings/developers > New OAuth App
# - Homepage URL: http://localhost:5173
# - Authorization callback URL: http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

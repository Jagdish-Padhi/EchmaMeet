# ============================================================================
# EchmaMeet Environment Configuration Template
# ============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# NOTE: .env is ignored by git and must never be committed.
# All fields below are pre-configured with resilient defaults.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Server Core Configuration
# ----------------------------------------------------------------------------
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
DATA_DIR=./data
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# 2. Database: PostgreSQL (Neon Serverless / Supabase / Local PostgreSQL)
# ----------------------------------------------------------------------------
# Where to get: Free tier at https://neon.tech or https://supabase.com
# Example: postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# NOTE: If left empty, EchmaMeet automatically uses embedded zero-config SQLite (./data/chaosboard.sqlite).
DATABASE_URL=

# ----------------------------------------------------------------------------
# 3. Distributed Job Queue: Redis & BullMQ (Upstash / Local Redis)
# ----------------------------------------------------------------------------
# Where to get: Free serverless Redis at https://upstash.com
# Example: rediss://default:token@xyz.upstash.io:6379
# NOTE: If left empty, EchmaMeet executes all background failure runs and chaos trials in-process.
REDIS_URL=

# ----------------------------------------------------------------------------
# 4. SRE Copilot & Autonomous Repair Model Engine
# ----------------------------------------------------------------------------
# Option A: Groq (100% Free & Fast for Continuous Dev & End-to-End Testing)
# Get free key at https://console.groq.com/keys
PARTNER_BASE_URL=https://api.groq.com/openai/v1
PARTNER_API_KEY=
PARTNER_MODEL_ID=llama-3.3-70b-versatile

# Option B: Official Meta Developer Platform ($150 Hackathon Credits)
# Get key at https://dev.meta.ai
# - muse-wonder-1.0            : Flagship frontier coding model (1M ctx) for deep autonomous repairs & RCA
# - muse-spark-1.3             : Low-latency copilot for live meeting hazard warnings
# - muse-spark-1.3-contributor : Ultra-low-cost tier ($0.10/1M tokens)
# PARTNER_BASE_URL=https://api.meta.ai/v1
# PARTNER_API_KEY=
# PARTNER_MODEL_ID=muse-wonder-1.0

# ----------------------------------------------------------------------------
# 5. Chaos Injection Engine: Toxiproxy HTTP API
# ----------------------------------------------------------------------------
# Where to get: https://github.com/Shopify/toxiproxy (releases or docker run -p 8474:8474 ghcr.io/shopify/toxiproxy)
# - Host native: http://127.0.0.1:8474
# - Docker network: http://toxiproxy:8474
TOXIPROXY_URL=http://127.0.0.1:8474

# ----------------------------------------------------------------------------
# 6. Meta Multimodal Vision API (Whiteboard Segmentation & SAM 3.1)
# ----------------------------------------------------------------------------
# Used for advanced whiteboard diagram ingestion.
# NOTE: If left empty, EchmaMeet automatically uses deterministic geometry & color-threshold parsing.
META_API_KEY=

# ----------------------------------------------------------------------------
# 7. Authentication & Security (JWT Session Signing)
# ----------------------------------------------------------------------------
# Secret key for HMAC-SHA256 session token generation. Change to any random string in production.
JWT_SECRET=echmameet-enterprise-jwt-secret-replace-with-your-key-2026
JWT_EXPIRES_IN=1209600

# ----------------------------------------------------------------------------
# 8. Firebase Google Authentication (Quick, Free & Stable Popup Login)
# ----------------------------------------------------------------------------
# Where to get (Free in 2 mins at https://console.firebase.google.com):
# 1. Click "Add project" (or select an existing one).
# 2. Go to "Build" > "Authentication" > "Get Started" > enable "Google".
# 3. Go to Project Settings (gear icon) > "General" > scroll down to "Your apps" > click "</>" (Web).
# 4. Copy the keys from the firebaseConfig snippet below:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server Firebase project validation:
FIREBASE_PROJECT_ID=
GOOGLE_CLIENT_ID=

# ----------------------------------------------------------------------------
# 9. Single Sign-On (SSO): GitHub OAuth App
# ----------------------------------------------------------------------------
# Where to get: https://github.com/settings/developers > New OAuth App
# - Homepage URL: http://localhost:5173
# - Authorization callback URL: http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

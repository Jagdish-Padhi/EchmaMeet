# Names only. Copy to .env and fill in real values. .env is never committed.

# Server (used now)
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
DATA_DIR=./data
LOG_LEVEL=info

# Toxiproxy control API (used from Phase 3)
TOXIPROXY_URL=

# Smoke scripts: Spark Open on a partner host (Phase 0)
PARTNER_BASE_URL=
PARTNER_API_KEY=
PARTNER_MODEL_ID=meta-models/muse-spark-open-1026
SMOKE_IMAGE_PATH=

# Smoke scripts: Meta Model API (Phase 0, generic probes read their own JSON files)
META_API_KEY=

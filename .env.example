# ============================================================================
# ChaosBoard Environment Configuration Template
# ============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# NOTE: .env is ignored by git and must never be committed.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Server Core Configuration
# ----------------------------------------------------------------------------
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
DATA_DIR=./data
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# 2. Database: PostgreSQL (Neon Serverless / Supabase / Local PostgreSQL)
# ----------------------------------------------------------------------------
# Free serverless tier at https://neon.tech
# Pooled connection string with SSL required.
# If left blank, ChaosBoard automatically defaults to embedded zero-config SQLite.
DATABASE_URL=

# ----------------------------------------------------------------------------
# 3. Distributed Job Queue: Redis & BullMQ (Upstash / Local Redis)
# ----------------------------------------------------------------------------
# Free serverless Redis tier at https://upstash.com
# Standard TLS connection string (rediss://default:token@xyz.upstash.io:6379).
# If left blank, ChaosBoard executes background experiments in-process.
REDIS_URL=

# ----------------------------------------------------------------------------
# 4. Meta AI SRE Model (OpenAI-compatible: Groq / Together AI / Fireworks / Local)
# ----------------------------------------------------------------------------
# Fast free inference for Llama 3 models (e.g. Groq free tier at https://groq.com):
# - PARTNER_BASE_URL=https://api.groq.com/openai/v1
# - PARTNER_MODEL_ID=llama-3.3-70b-versatile
# Or local Ollama/vLLM:
# - PARTNER_BASE_URL=http://127.0.0.1:8000/v1
# - PARTNER_MODEL_ID=meta-models/muse-spark-open-1026
PARTNER_BASE_URL=http://127.0.0.1:8000/v1
PARTNER_API_KEY=
PARTNER_MODEL_ID=meta-models/muse-spark-open-1026

# ----------------------------------------------------------------------------
# 5. Chaos Injection Engine: Toxiproxy HTTP API
# ----------------------------------------------------------------------------
# URL of the running Toxiproxy HTTP control API:
# - Host native: http://127.0.0.1:8474
# - Docker: http://toxiproxy:8474
TOXIPROXY_URL=http://127.0.0.1:8474

# ----------------------------------------------------------------------------
# 6. Meta Multimodal API (SAM 3.1 & Vision Architecture Extraction)
# ----------------------------------------------------------------------------
# Used for whiteboard image segmentation (SAM 3.1) and illustrative blueprint cards.
# If left blank, ChaosBoard uses deterministic color-threshold detection.
META_API_KEY=

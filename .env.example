# ============================================================================
# EchmaMeet Core Configuration (Optimized for Demo & Testing)
# ============================================================================
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
DATA_DIR=./data
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Database & Distributed Queue (Keep EMPTY for Embedded Zero-Config Mode)
# ----------------------------------------------------------------------------
# Leaving these empty activates native SQLite (./data/chaosboard.sqlite)
# and in-process execution. No PostgreSQL or Redis setup required!
DATABASE_URL=
REDIS_URL=

# ----------------------------------------------------------------------------
# Shopify Toxiproxy (Network Chaos Injection Engine)
# ----------------------------------------------------------------------------
TOXIPROXY_URL=http://127.0.0.1:8474
TOXIPROXY_UPSTREAM_HOST=127.0.0.1

# ----------------------------------------------------------------------------
# AI SRE Copilot & Autonomous Repair Engine
# ----------------------------------------------------------------------------
# Choose ONE of the providers below:

# OPTION A: Meta AI Hackathon Credits (Default)
PARTNER_BASE_URL=https://api.meta.ai/v1
PARTNER_API_KEY=your_meta_api_key_here
PARTNER_MODEL_ID=muse-spark-1.3
META_API_KEY=your_meta_api_key_here
META_API_BASE_URL=https://api.meta.ai/v1
META_SAM_MODEL_ID=sam-3.1
META_STT_MODE=ENDPOINTING

# OPTION B: Groq (Ultra-fast, Free API key at https://console.groq.com)
# If you don't have active Meta AI credits, uncomment these lines:
# AI_PROVIDER=groq
# PARTNER_BASE_URL=https://api.groq.com/openai/v1
# PARTNER_API_KEY=gsk_your_groq_api_key_here
# PARTNER_MODEL_ID=llama-3.3-70b-versatile

# Spend Guard for Demo
META_BUDGET_USD=150
META_RESERVE_USD=40

# ----------------------------------------------------------------------------
# Authentication & Demo Access
# ----------------------------------------------------------------------------
# 32+ character signing key
JWT_SECRET=super-secret-demo-signing-key-echmameet-2026-secure
JWT_EXPIRES_IN=1209600

# Enables seeded 1-click accounts and instant demo auth:
ALLOW_DEV_MOCK_AUTH=true

# ----------------------------------------------------------------------------
# WebRTC Connectivity (Meeting Rooms)
# ----------------------------------------------------------------------------
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=3600

# ----------------------------------------------------------------------------
# Optional Third-Party SSO (Leave blank for standard email/pass login)
# ----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# ============================================================================
# ChaosBoard Environment Configuration Template
# ============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# NOTE: .env is ignored by git and must never be committed.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Server Configuration
# ----------------------------------------------------------------------------
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
DATA_DIR=./data
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# 2. Chaos Injection: Toxiproxy Daemon
# ----------------------------------------------------------------------------
# URL of the running Toxiproxy HTTP control API.
# - If running Toxiproxy natively on your host: http://127.0.0.1:8474
# - If running via Docker Compose: http://127.0.0.1:8474 (or http://toxiproxy:8474 inside containers)
TOXIPROXY_URL=http://127.0.0.1:8474

# ----------------------------------------------------------------------------
# 3. Meta Spark Open Model (OpenAI-compatible Partner API)
# ----------------------------------------------------------------------------
# Used for autonomous resilience policy repair proposals and voice intent parsing.
# Compatible with Baseten, Fireworks AI, Together AI, or any local vLLM/Ollama OpenAI-compatible endpoint.
# If left blank, ChaosBoard gracefully falls back to deterministic rule-based repair algorithms.
PARTNER_BASE_URL=http://127.0.0.1:8000/v1
PARTNER_API_KEY=
PARTNER_MODEL_ID=meta-models/muse-spark-open-1026

# Optional test image path for smoke testing vision endpoints
SMOKE_IMAGE_PATH=

# ----------------------------------------------------------------------------
# 4. Meta Multimodal API (SAM 3.1 & Muse Image)
# ----------------------------------------------------------------------------
# Used for whiteboard image segmentation (SAM 3.1) and illustrative blueprint cards (Muse Image).
# If left blank, ChaosBoard automatically executes pure-TypeScript color-threshold detection
# and deterministic SVG architecture vector generation.
META_API_KEY=

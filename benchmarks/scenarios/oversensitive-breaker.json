{
  "schemaVersion": 1,
  "id": "oversensitive-breaker",
  "name": "Over-sensitive circuit breaker",
  "description": "A breaker with very low threshold and window turning minor noise into outage.",
  "designedFailureMode": "Premature circuit breaker trips converting transient errors into extended full outage",
  "expectedOutcome": "VIOLATED",
  "topology": {
    "schemaVersion": 1,
    "id": "oversensitive-breaker",
    "name": "Over-sensitive circuit breaker",
    "source": "scenario",
    "entry": {
      "nodeId": "gateway"
    },
    "nodes": [
      {
        "id": "gateway",
        "label": "Gateway",
        "kind": "service",
        "processing": {
          "distribution": "constant",
          "ms": 20
        },
        "concurrency": {
          "maxWorkers": 20
        },
        "queue": {
          "mode": "bounded",
          "maxDepth": 500
        },
        "ingressRateLimitRps": null
      },
      {
        "id": "profile",
        "label": "Profile service",
        "kind": "service",
        "processing": {
          "distribution": "constant",
          "ms": 20
        },
        "concurrency": {
          "maxWorkers": 20
        },
        "queue": {
          "mode": "bounded",
          "maxDepth": 500
        },
        "ingressRateLimitRps": null
      },
      {
        "id": "profile-db",
        "label": "Profile store",
        "kind": "service",
        "processing": {
          "distribution": "constant",
          "ms": 20
        },
        "concurrency": {
          "maxWorkers": 20
        },
        "queue": {
          "mode": "bounded",
          "maxDepth": 500
        },
        "ingressRateLimitRps": null
      }
    ],
    "edges": [
      {
        "id": "gateway-to-profile",
        "source": "gateway",
        "target": "profile",
        "mode": "sync_call",
        "policy": {
          "timeoutMs": 5000,
          "retry": {
            "maxAttempts": 1,
            "backoffBaseMs": 0,
            "backoffMultiplier": 1,
            "maxBackoffMs": 0,
            "jitter": "none"
          },
          "breaker": {
            "enabled": false,
            "failureThresholdPct": 50,
            "windowRequests": 20,
            "cooldownMs": 2000,
            "halfOpenProbes": 2
          },
          "fallback": "fail_fast_503",
          "idempotency": {
            "sendKey": false
          },
          "pool": {
            "maxConnections": 50
          }
        }
      },
      {
        "id": "profile-to-profile-db",
        "source": "profile",
        "target": "profile-db",
        "mode": "sync_call",
        "policy": {
          "timeoutMs": 2000,
          "retry": {
            "maxAttempts": 1,
            "backoffBaseMs": 0,
            "backoffMultiplier": 1,
            "maxBackoffMs": 0,
            "jitter": "none"
          },
          "breaker": {
            "enabled": true,
            "failureThresholdPct": 10,
            "windowRequests": 5,
            "cooldownMs": 10000,
            "halfOpenProbes": 1
          },
          "fallback": "fail_fast_503",
          "idempotency": {
            "sendKey": false
          },
          "pool": {
            "maxConnections": 50
          }
        }
      }
    ]
  },
  "faults": [
    {
      "id": "fault-reset-profile-db",
      "edgeId": "profile-to-profile-db",
      "type": "connection_reset",
      "afterMs": 0,
      "toxicity": 0.15,
      "direction": "downstream",
      "startOffsetMs": 0
    }
  ],
  "invariants": [
    {
      "id": "inv-completion",
      "metric": "completion_rate",
      "scope": {
        "kind": "system"
      },
      "comparator": "gte",
      "threshold": 0.8
    },
    {
      "id": "inv-breaker-open",
      "metric": "breaker_open_fraction",
      "scope": {
        "kind": "edge",
        "edgeId": "profile-to-profile-db"
      },
      "comparator": "lte",
      "threshold": 0.2
    }
  ],
  "trialConfig": {
    "arrivalRateRps": 10,
    "arrivalProcess": "constant",
    "warmupMs": 500,
    "measurementMs": 1500,
    "cooldownMs": 100,
    "clientTimeoutMs": 2000,
    "seed": 50005,
    "trials": 5
  }
}

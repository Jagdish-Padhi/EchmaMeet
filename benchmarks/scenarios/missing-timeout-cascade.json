{
  "schemaVersion": 1,
  "id": "missing-timeout-cascade",
  "name": "Missing timeout cascade",
  "description": "A caller with no timeout on a dependency whose connections stall.",
  "designedFailureMode": "Workers pinned by stalled downstream connection with failure cascading upstream",
  "expectedOutcome": "VIOLATED",
  "topology": {
    "schemaVersion": 1,

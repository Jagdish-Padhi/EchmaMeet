{
  "schemaVersion": 1,
  "id": "retry-storm",
  "name": "Synchronous retry storm",
  "description": "A caller with several immediate retries and a long timeout, a downstream slowed by added latency with jitter.",
  "designedFailureMode": "Synchronous retry storm causing worker exhaustion downstream",
  "expectedOutcome": "VIOLATED",
  "topology": {
    "schemaVersion": 1,
    "id": "retry-storm",
    "name": "Synchronous retry storm",
    "source": "scenario",
    "entry": {
      "nodeId": "gateway"
    },
    "nodes": [
      {
        "id": "gateway",
        "label": "Gateway",
        "kind": "service",
        "processing": {
          "distribution": "constant",
          "ms": 20
        },
        "concurrency": {
          "maxWorkers": 50
        },
        "queue": {
          "mode": "bounded",
          "maxDepth": 500
        },
        "ingressRateLimitRps": null
      },
      {
        "id": "checkout",
        "label": "Checkout",
        "kind": "service",
        "processing": {
          "distribution": "constant",
          "ms": 20
        },
        "concurrency": {
          "maxWorkers": 30
        },
        "queue": {
          "mode": "bounded",
          "maxDepth": 500
        },
        "ingressRateLimitRps": null
      },
      {
        "id": "inventory",
        "label": "Inventory",
        "kind": "service",
        "processing": {
          "distribution": "constant",
          "ms": 25
        },
        "concurrency": {
          "maxWorkers": 20
        },
        "queue": {
          "mode": "bounded",
          "maxDepth": 500
        },
        "ingressRateLimitRps": null
      }
    ],
    "edges": [
      {
        "id": "gateway-to-checkout",
        "source": "gateway",
        "target": "checkout",
        "mode": "sync_call",
        "policy": {
          "timeoutMs": 5000,
          "retry": {
            "maxAttempts": 3,
            "backoffBaseMs": 0,
            "backoffMultiplier": 1,
            "maxBackoffMs": 0,
            "jitter": "none"
          },
          "breaker": {
            "enabled": false,
            "failureThresholdPct": 50,
            "windowRequests": 20,
            "cooldownMs": 2000,
            "halfOpenProbes": 2
          },
          "fallback": "fail_fast_503",
          "idempotency": {
            "sendKey": false
          },
          "pool": {
            "maxConnections": 50
          }
        }
      },
      {
        "id": "checkout-to-inventory",
        "source": "checkout",
        "target": "inventory",
        "mode": "sync_call",
        "policy": {
          "timeoutMs": 3000,
          "retry": {
            "maxAttempts": 3,
            "backoffBaseMs": 0,
            "backoffMultiplier": 1,
            "maxBackoffMs": 0,
            "jitter": "none"
          },
          "breaker": {
            "enabled": false,
            "failureThresholdPct": 50,
            "windowRequests": 20,
            "cooldownMs": 2000,
            "halfOpenProbes": 2
          },
          "fallback": "fail_fast_503",
          "idempotency": {
            "sendKey": false
          },
          "pool": {
            "maxConnections": 50
          }
        }
      }
    ]
  },
  "faults": [
    {
      "id": "fault-latency-inventory",
      "edgeId": "checkout-to-inventory",
      "type": "latency",
      "latencyMs": 800,
      "jitterMs": 200,
      "toxicity": 1.0,
      "direction": "downstream",
      "startOffsetMs": 0
    }
  ],
  "invariants": [
    {
      "id": "inv-p99",
      "metric": "e2e_p99_ms",
      "scope": {
        "kind": "system"
      },
      "comparator": "lte",
      "threshold": 500
    },
    {
      "id": "inv-completion",
      "metric": "completion_rate",
      "scope": {
        "kind": "system"
      },
      "comparator": "gte",
      "threshold": 0.95
    },
    {
      "id": "inv-retry",
      "metric": "retry_amplification",
      "scope": {
        "kind": "edge",
        "edgeId": "checkout-to-inventory"
      },
      "comparator": "lte",
      "threshold": 1.5
    }
  ],
  "trialConfig": {
    "arrivalRateRps": 10,
    "arrivalProcess": "constant",
    "warmupMs": 500,
    "measurementMs": 1500,
    "cooldownMs": 100,
    "clientTimeoutMs": 3000,
    "seed": 10001,
    "trials": 5
  }
}

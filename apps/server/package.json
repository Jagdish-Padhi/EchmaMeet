  },
  "dependencies": {
    "@chaosboard/contracts": "workspace:*",
    "@chaosboard/shared": "workspace:*",
    "fastify": "5.12.7",
    "pino": "10.4.0",
    "ws": "^8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
